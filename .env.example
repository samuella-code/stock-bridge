SECRET_KEY=replace-with-a-long-random-secret
# Use SQLite locally. In production, replace this with the pooled PostgreSQL
# connection string supplied by Neon (or another managed PostgreSQL service).
DATABASE_URL=sqlite:///stockbridge.db
FLASK_APP=app:create_app
FLASK_ENV=development
PAYSTACK_SECRET_KEY=sk_test_replace_me
PAYSTACK_PUBLIC_KEY=pk_test_replace_me
LIFETIME_PRICE_NAIRA=3000
ADMIN_EMAILS=owner@example.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=replace_me
SMTP_PASSWORD=replace_me
SMTP_FROM_EMAIL=noreply@example.com
SMTP_USE_TLS=true

# Vercel supplies this automatically; do not add it manually.
# VERCEL=1
