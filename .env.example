SECRET_KEY=replace-with-a-long-random-secret
DATABASE_URL=sqlite:///stockbridge.db
FLASK_APP=app:create_app
FLASK_ENV=development
PAYSTACK_SECRET_KEY=replace-with-your-paystack-secret-key
PAYSTACK_PUBLIC_KEY=replace-with-your-paystack-public-key
LIFETIME_PRICE_NAIRA=3000
SMTP_HOST=your-smtp-host
SMTP_PORT=587
SMTP_USERNAME=your-smtp-username
SMTP_PASSWORD=replace-with-your-smtp-password
SMTP_FROM_EMAIL=noreply@example.com
SMTP_FROM_NAME=StockBridge
SMTP_USE_TLS=true

# Vercel supplies this automatically; do not add it manually.
# VERCEL=1

# Optional social sign-in. Leave blank until configured for this environment.
# Use separate staging and production provider registrations; do not paste secrets into chat.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APPLE_REDIRECT_URI=
